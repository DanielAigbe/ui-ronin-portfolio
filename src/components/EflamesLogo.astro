<style is:global>
.ef path,.ef g{transform-box:fill-box;transform-origin:center}
.ef-char{animation:ef-pop .7s cubic-bezier(.34,1.56,.64,1) both}
.ef .ef-flame{transform-origin:50% 100%;animation:ef-flicker 1.5s ease-in-out 1s infinite}
.ef-l1{animation:ef-rise .5s ease-out both;animation-delay:calc(.45s + var(--i)*.07s)}
.ef-l2{animation:ef-drop .55s cubic-bezier(.34,1.56,.64,1) both;animation-delay:calc(1.05s + var(--i)*.06s)}
.ef .ef-line{transform-origin:0 50%;animation:ef-wipe .6s cubic-bezier(.7,0,.2,1) 1.7s both}
.ef-spark{animation:ef-pop .4s cubic-bezier(.34,1.56,.64,1) both,ef-twinkle 2.4s ease-in-out infinite;animation-delay:calc(2.1s + var(--i)*.05s),calc(2.6s + var(--i)*.3s)}
@keyframes ef-pop{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:none}}
@keyframes ef-rise{from{opacity:0;transform:translateY(40%) rotate(-6deg)}to{opacity:1;transform:none}}
@keyframes ef-drop{from{opacity:0;transform:translateY(-45%)}to{opacity:1;transform:none}}
@keyframes ef-wipe{from{opacity:0;transform:scaleX(0)}to{opacity:1;transform:none}}
@keyframes ef-flicker{0%,100%{transform:none}30%{transform:scaleY(1.035) skewX(-1.6deg)}60%{transform:scaleY(.985) skewX(1.4deg)}80%{transform:scaleY(1.02) skewX(-.8deg)}}
@keyframes ef-twinkle{0%,100%{opacity:1}50%{opacity:.45}}
@media (prefers-reduced-motion:reduce){.ef *{animation:none!important}}
.js [data-ef]:not(.go) .ef * { animation-play-state: paused !important; }
</style>
